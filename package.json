{
  "name": "mecanica-reis",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/finance.test.ts tests/services.test.ts tests/pdf",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "db:types": "npx supabase gen types typescript --local > src/types/database.generated.ts",
    "db:integration:env": "node scripts/prepare-integration-env.mjs",
    "db:integration:setup": "npm run db:integration:env && node scripts/setup-integration-user.mjs",
    "pdf:examples": "GENERATE_PDF_EXAMPLES=1 vitest run tests/pdf/pdf.test.tsx"
  },
  "keywords": [
    "supabase",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "zod": "^3.25.76"
  }
}
