{
  "name": "mecanica-reis",
  "version": "1.0.0",
  "description": "",
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/finance.test.ts tests/services.test.ts tests/pdf",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx supabase db reset",
    "db:test": "npx supabase test db",
    "db:types": "npx supabase gen types typescript --local > src/types/database.generated.ts",
    "db:integration:env": "node scripts/prepare-integration-env.mjs",
    "db:integration:setup": "npm run db:integration:env && node scripts/setup-integration-user.mjs",
    "pdf:examples": "GENERATE_PDF_EXAMPLES=1 vitest run tests/pdf/pdf.test.tsx",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts"
  },
  "keywords": [
    "supabase",
    "postgresql",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  }
}
